# API Security Scanner Configuration Template
# Copy this file to .env and modify the values as needed
# All values are optional - defaults will be used if not specified

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
DEBUG=false
VERBOSE=false
APP_NAME=API Security Scanner

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Path to the SQLite database file
DB_PATH=scan_results.db

# Enable automatic database backups
DB_BACKUP_ENABLED=true

# Backup interval in hours
DB_BACKUP_INTERVAL=24

# Maximum number of backup files to keep
DB_MAX_BACKUPS=7

# Database connection timeout in seconds
DB_CONNECTION_TIMEOUT=30

# =============================================================================
# ZAP (OWASP Zed Attack Proxy) CONFIGURATION
# =============================================================================
# Path to ZAP executable (leave empty for auto-detection)
ZAP_PATH=

# ZAP host (use 'zap' for Docker Compose, 'localhost' for local)
ZAP_HOST=localhost

# ZAP port
ZAP_PORT=8080

# ZAP API key (optional, for authentication)
ZAP_API_KEY=

# ZAP connection timeout in seconds
ZAP_TIMEOUT=300

# Maximum scan time in seconds
ZAP_MAX_SCAN_TIME=3600

# Spider depth (how deep to crawl)
ZAP_SPIDER_DEPTH=5

# Maximum children per node
ZAP_MAX_CHILDREN=10

# Number of threads for scanning
ZAP_THREAD_COUNT=2

# Use external ZAP instance (true/false)
ZAP_EXTERNAL=false

# Run ZAP in daemon mode (true/false)
ZAP_DAEMON=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log directory
LOG_DIR=logs

# Enable file logging (true/false)
LOG_FILE_ENABLED=true

# Enable console logging (true/false)
LOG_CONSOLE_ENABLED=true

# Maximum log file size in bytes (10MB default)
LOG_MAX_FILE_SIZE=10485760

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# =============================================================================
# REPORT CONFIGURATION
# =============================================================================
# Report output directory
REPORT_DIR=reports

# Template directory for reports
REPORT_TEMPLATE_DIR=templates

# Include screenshots in reports (true/false)
REPORT_INCLUDE_SCREENSHOTS=true

# Include proof-of-concept in reports (true/false)
REPORT_INCLUDE_POC=true

# Maximum report size in bytes (50MB default)
REPORT_MAX_SIZE=52428800

# Automatically open reports after generation (true/false)
REPORT_AUTO_OPEN=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Maximum requests per second
MAX_REQUESTS_PER_SECOND=10

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Verify SSL certificates (true/false)
VERIFY_SSL=true

# Follow redirects (true/false)
FOLLOW_REDIRECTS=true

# Maximum number of redirects to follow
MAX_REDIRECTS=5

# User agent string for requests
USER_AGENT=API-Security-Scanner/1.0.0

# =============================================================================
# PLUGIN CONFIGURATION
# =============================================================================
# Comma-separated list of enabled plugins
ENABLED_PLUGINS=CORSChecker,RateLimitingChecker,SecurityHeadersChecker,EnhancedSecurityChecker

# Plugin execution timeout in seconds
PLUGIN_TIMEOUT=60

# Maximum number of concurrent plugins
MAX_CONCURRENT_PLUGINS=3

# Directory for custom plugins
CUSTOM_PLUGIN_DIR=custom_plugins

# =============================================================================
# CONTAINER CONFIGURATION
# =============================================================================
# Data directory in container
CONTAINER_DATA_DIR=/app/data

# Logs directory in container
CONTAINER_LOGS_DIR=/app/logs

# Reports directory in container
CONTAINER_REPORTS_DIR=/app/reports

# Workspace directory in container
CONTAINER_WORKSPACE_DIR=/workspace

# ZAP container name (for Docker Compose)
ZAP_CONTAINER_NAME=zap

# Network mode for containers
CONTAINER_NETWORK_MODE=bridge

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
# Default authentication type (none, header, cookie, token, basic, bearer)
AUTH_TYPE=none

# Default authentication header name
AUTH_HEADER_NAME=Authorization

# Default authentication cookie name
AUTH_COOKIE_NAME=session

# Default authentication token name
AUTH_TOKEN_NAME=token

# Default username for basic authentication
AUTH_USERNAME=

# Default password for basic authentication
AUTH_PASSWORD=

# =============================================================================
# PROXY CONFIGURATION (OPTIONAL)
# =============================================================================
# Enable proxy support (true/false) - Only enable if you need to route traffic through a proxy
PROXY_ENABLED=false

# HTTP proxy URL (e.g., http://proxy.example.com:8080)
# Leave empty if not using proxy
HTTP_PROXY=

# HTTPS proxy URL (e.g., https://proxy.example.com:8080)
# Leave empty if not using proxy
HTTPS_PROXY=

# Comma-separated list of hosts to bypass proxy (e.g., localhost,127.0.0.1,.local)
# Useful for local development or internal services
NO_PROXY=

# Verify SSL certificates when using proxy (true/false)
PROXY_VERIFY_SSL=true

# Proxy request timeout in seconds
PROXY_TIMEOUT=30

# Maximum number of retries for failed requests
PROXY_MAX_RETRIES=3

# Delay between retries in seconds
PROXY_RETRY_DELAY=1.0

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================
# Enable email notifications (true/false)
EMAIL_ENABLED=false

# SMTP server host
SMTP_HOST=

# SMTP server port
SMTP_PORT=587

# SMTP username
SMTP_USERNAME=

# SMTP password
SMTP_PASSWORD=

# Email sender address
EMAIL_FROM=

# Email recipient addresses (comma-separated)
EMAIL_TO=

# Enable Slack notifications (true/false)
SLACK_ENABLED=false

# Slack webhook URL
SLACK_WEBHOOK_URL=

# Slack channel
SLACK_CHANNEL=

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Enable performance monitoring (true/false)
PERFORMANCE_MONITORING=true

# Performance metrics collection interval in seconds
PERFORMANCE_INTERVAL=60

# Maximum memory usage in MB
MAX_MEMORY_USAGE=1024

# Enable caching (true/false)
CACHE_ENABLED=true

# Cache directory
CACHE_DIR=cache

# Cache expiration time in seconds
CACHE_EXPIRATION=3600

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Enable development mode (true/false)
DEV_MODE=false

# Enable hot reloading (true/false)
HOT_RELOAD=false

# Enable debug toolbar (true/false)
DEBUG_TOOLBAR=false

# Enable profiling (true/false)
PROFILING=false

# =============================================================================
# INTEGRATION CONFIGURATION
# =============================================================================
# Enable CI/CD integration (true/false)
CI_CD_ENABLED=false

# CI/CD pipeline name
CI_CD_PIPELINE=

# CI/CD build number
CI_CD_BUILD=

# CI/CD environment
CI_CD_ENVIRONMENT=

# Enable JIRA integration (true/false)
JIRA_ENABLED=false

# JIRA server URL
JIRA_URL=

# JIRA username
JIRA_USERNAME=

# JIRA API token
JIRA_API_TOKEN=

# JIRA project key
JIRA_PROJECT=

# =============================================================================
# CUSTOM CONFIGURATION
# =============================================================================
# Add any custom configuration variables here
# CUSTOM_VAR1=value1
# CUSTOM_VAR2=value2
