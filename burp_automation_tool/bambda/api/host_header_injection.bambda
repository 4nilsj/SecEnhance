# Host Header Injection Security Bambda
# Detects host header injection vulnerabilities

metadata:
  name: "Host Header Injection Security Bambda"
  description: "Detects host header injection vulnerabilities including cache poisoning, SSRF, and authentication bypass"
  author: "Burp Automation Tool"
  version: "1.0.0"
  tags: ["host-header", "cache-poisoning", "ssrf", "authentication-bypass", "header-injection"]

rules:
  - name: "Host Header Manipulation"
    description: "Detects host header manipulation vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Host: evil.com"
          - payload: "Host: attacker.com"
          - payload: "Host: malicious.com"
          - payload: "Host: hacker.com"
          - payload: "Host: exploit.com"
        then:
          - if: "response.status == 200"
            issue: "Host Header Manipulation"
            detail: "Host header manipulation vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Cache Poisoning via Host Header"
    description: "Detects cache poisoning via host header injection"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Host: evil.com"
          - payload: "Host: attacker.com"
          - payload: "Host: malicious.com"
          - payload: "Host: hacker.com"
          - payload: "Host: exploit.com"
        then:
          - if: "response.headers contains 'X-Cache'"
            issue: "Cache Poisoning via Host Header"
            detail: "Cache poisoning vulnerability via host header injection"
            severity: "High"
            confidence: "Medium"

  - name: "SSRF via Host Header"
    description: "Detects SSRF vulnerabilities via host header injection"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Host: 127.0.0.1"
          - payload: "Host: localhost"
          - payload: "Host: 192.168.1.1"
          - payload: "Host: 10.0.0.1"
          - payload: "Host: 172.16.0.1"
        then:
          - if: "response.status == 200"
            issue: "SSRF via Host Header"
            detail: "SSRF vulnerability via host header injection"
            severity: "High"
            confidence: "Medium"

  - name: "Authentication Bypass via Host Header"
    description: "Detects authentication bypass via host header injection"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Host: admin.localhost"
          - payload: "Host: admin.127.0.0.1"
          - payload: "Host: internal.localhost"
          - payload: "Host: internal.127.0.0.1"
          - payload: "Host: localhost:8080"
        then:
          - if: "response.status == 200"
            issue: "Authentication Bypass via Host Header"
            detail: "Authentication bypass vulnerability via host header injection"
            severity: "High"
            confidence: "Medium"

  - name: "Password Reset Poisoning"
    description: "Detects password reset poisoning via host header injection"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Host: evil.com"
          - payload: "Host: attacker.com"
          - payload: "Host: malicious.com"
          - payload: "Host: hacker.com"
          - payload: "Host: exploit.com"
        then:
          - if: "response.body contains 'reset'"
            issue: "Password Reset Poisoning"
            detail: "Password reset poisoning vulnerability via host header injection"
            severity: "High"
            confidence: "Medium"

  - name: "Email Header Injection"
    description: "Detects email header injection via host header"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Host: evil.com\r\nFrom: attacker@evil.com"
          - payload: "Host: attacker.com\r\nReply-To: attacker@attacker.com"
          - payload: "Host: malicious.com\r\nReturn-Path: attacker@malicious.com"
          - payload: "Host: hacker.com\r\nX-Mailer: attacker@hacker.com"
          - payload: "Host: exploit.com\r\nSender: attacker@exploit.com"
        then:
          - if: "response.status == 200"
            issue: "Email Header Injection"
            detail: "Email header injection vulnerability via host header"
            severity: "Medium"
            confidence: "Medium"

  - name: "Open Redirect via Host Header"
    description: "Detects open redirect vulnerabilities via host header injection"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Host: evil.com"
          - payload: "Host: attacker.com"
          - payload: "Host: malicious.com"
          - payload: "Host: hacker.com"
          - payload: "Host: exploit.com"
        then:
          - if: "response.headers contains 'Location'"
            issue: "Open Redirect via Host Header"
            detail: "Open redirect vulnerability via host header injection"
            severity: "Medium"
            confidence: "Medium"

  - name: "Web Cache Deception"
    description: "Detects web cache deception via host header injection"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Host: evil.com"
          - payload: "Host: attacker.com"
          - payload: "Host: malicious.com"
          - payload: "Host: hacker.com"
          - payload: "Host: exploit.com"
        then:
          - if: "response.headers contains 'X-Cache'"
            issue: "Web Cache Deception"
            detail: "Web cache deception vulnerability via host header injection"
            severity: "Medium"
            confidence: "Medium"

  - name: "Host Header Override"
    description: "Detects host header override vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "X-Forwarded-Host: evil.com"
          - payload: "X-Forwarded-Host: attacker.com"
          - payload: "X-Forwarded-Host: malicious.com"
          - payload: "X-Forwarded-Host: hacker.com"
          - payload: "X-Forwarded-Host: exploit.com"
        then:
          - if: "response.status == 200"
            issue: "Host Header Override"
            detail: "Host header override vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Multiple Host Headers"
    description: "Detects multiple host headers injection"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Host: evil.com\r\nHost: original.com"
          - payload: "Host: attacker.com\r\nHost: original.com"
          - payload: "Host: malicious.com\r\nHost: original.com"
          - payload: "Host: hacker.com\r\nHost: original.com"
          - payload: "Host: exploit.com\r\nHost: original.com"
        then:
          - if: "response.status == 200"
            issue: "Multiple Host Headers"
            detail: "Multiple host headers injection vulnerability detected"
            severity: "Medium"
            confidence: "Medium"

filters:
  - name: "Authentication Endpoints"
    when: "request"
    where: "request.url"
    include:
      - pattern: "/auth"
        flags: "i"
      - pattern: "/login"
        flags: "i"
      - pattern: "/password"
        flags: "i"
      - pattern: "/reset"
        flags: "i"
      - pattern: "/admin"
        flags: "i"

settings:
  max_payloads_per_parameter: 10
  timeout: 10000
  follow_redirects: true
  respect_robots_txt: false
