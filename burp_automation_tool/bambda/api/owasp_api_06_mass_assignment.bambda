# OWASP API Top 10 #6: Mass Assignment Bambda
# Detects mass assignment vulnerabilities in APIs

metadata:
  name: "OWASP API #6: Mass Assignment"
  description: "Detects mass assignment vulnerabilities where attackers can modify object properties they shouldn't have access to"
  author: "Burp Automation Tool"
  version: "1.0.0"
  tags: ["owasp", "api", "mass-assignment", "object-injection", "property-override"]

rules:
  - name: "User Role Assignment"
    description: "Detects unauthorized user role assignment"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"role":"admin"}'
          - payload: '{"user_role":"admin"}'
          - payload: '{"is_admin":true}'
          - payload: '{"admin":true}'
          - payload: '{"privileges":"admin"}'
        then:
          - if: "response.status == 200"
            issue: "User Role Assignment"
            detail: "Unauthorized user role assignment vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Account Status Manipulation"
    description: "Detects unauthorized account status manipulation"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"active":true}'
          - payload: '{"enabled":true}'
          - payload: '{"verified":true}'
          - payload: '{"locked":false}'
          - payload: '{"suspended":false}'
        then:
          - if: "response.status == 200"
            issue: "Account Status Manipulation"
            detail: "Unauthorized account status manipulation vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Payment Information Assignment"
    description: "Detects unauthorized payment information assignment"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"payment_method":"credit_card"}'
          - payload: '{"billing_address":"attacker_address"}'
          - payload: '{"credit_limit":999999}'
          - payload: '{"discount_rate":100}'
          - payload: '{"payment_terms":"net_0"}'
        then:
          - if: "response.status == 200"
            issue: "Payment Information Assignment"
            detail: "Unauthorized payment information assignment vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Security Settings Override"
    description: "Detects unauthorized security settings override"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"two_factor_enabled":false}'
          - payload: '{"mfa_required":false}'
          - payload: '{"password_expires":false}'
          - payload: '{"session_timeout":999999}'
          - payload: '{"login_attempts":0}'
        then:
          - if: "response.status == 200"
            issue: "Security Settings Override"
            detail: "Unauthorized security settings override vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Business Logic Override"
    description: "Detects unauthorized business logic override"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"price":0}'
          - payload: '{"cost":0}'
          - payload: '{"quantity":999999}'
          - payload: '{"discount":100}'
          - payload: '{"tax_rate":0}'
        then:
          - if: "response.status == 200"
            issue: "Business Logic Override"
            detail: "Unauthorized business logic override vulnerability detected"
            severity: "Medium"
            confidence: "Medium"

  - name: "System Configuration Assignment"
    description: "Detects unauthorized system configuration assignment"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"debug_mode":true}'
          - payload: '{"maintenance_mode":false}'
          - payload: '{"log_level":"debug"}'
          - payload: '{"backup_enabled":false}'
          - payload: '{"monitoring_enabled":false}'
        then:
          - if: "response.status == 200"
            issue: "System Configuration Assignment"
            detail: "Unauthorized system configuration assignment vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "API Key Assignment"
    description: "Detects unauthorized API key assignment"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"api_key":"attacker_key"}'
          - payload: '{"access_token":"attacker_token"}'
          - payload: '{"secret_key":"attacker_secret"}'
          - payload: '{"client_id":"attacker_client"}'
          - payload: '{"client_secret":"attacker_secret"}'
        then:
          - if: "response.status == 200"
            issue: "API Key Assignment"
            detail: "Unauthorized API key assignment vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Metadata Override"
    description: "Detects unauthorized metadata override"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"created_by":"attacker"}'
          - payload: '{"created_at":"2020-01-01"}'
          - payload: '{"updated_by":"attacker"}'
          - payload: '{"version":999}'
          - payload: '{"revision":999}'
        then:
          - if: "response.status == 200"
            issue: "Metadata Override"
            detail: "Unauthorized metadata override vulnerability detected"
            severity: "Medium"
            confidence: "Medium"

  - name: "Permission Assignment"
    description: "Detects unauthorized permission assignment"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"permissions":["read","write","delete","admin"]}'
          - payload: '{"access_level":"full"}'
          - payload: '{"capabilities":["all"]}'
          - payload: '{"rights":["read","write","execute"]}'
          - payload: '{"privileges":["user","admin","system"]}'
        then:
          - if: "response.status == 200"
            issue: "Permission Assignment"
            detail: "Unauthorized permission assignment vulnerability detected"
            severity: "High"
            confidence: "Medium"

filters:
  - name: "API Endpoints"
    when: "request"
    where: "request.url"
    include:
      - pattern: "/api/"
        flags: "i"
      - pattern: "/users/"
        flags: "i"
      - pattern: "/profile/"
        flags: "i"
      - pattern: "/account/"
        flags: "i"

settings:
  max_payloads_per_parameter: 15
  timeout: 10000
  follow_redirects: false
  respect_robots_txt: false
