# OWASP API Top 10 #5: Broken Function Level Authorization Bambda
# Detects broken function level authorization vulnerabilities in APIs

metadata:
  name: "OWASP API #5: Broken Function Level Authorization"
  description: "Detects broken function level authorization vulnerabilities where users can access functions they shouldn't have access to"
  author: "Burp Automation Tool"
  version: "1.0.0"
  tags: ["owasp", "api", "authorization", "function-level", "privilege-escalation"]

rules:
  - name: "Admin Function Access"
    description: "Detects unauthorized access to admin functions"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/admin/users"
          - payload: "/admin/settings"
          - payload: "/admin/config"
          - payload: "/admin/system"
          - payload: "/admin/backup"
        then:
          - if: "response.status == 200"
            issue: "Admin Function Access"
            detail: "Unauthorized access to admin functions"
            severity: "High"
            confidence: "Medium"

  - name: "User Management Bypass"
    description: "Detects unauthorized access to user management functions"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/users/create"
          - payload: "/users/delete"
          - payload: "/users/update"
          - payload: "/users/list"
          - payload: "/users/roles"
        then:
          - if: "response.status == 200"
            issue: "User Management Bypass"
            detail: "Unauthorized access to user management functions"
            severity: "High"
            confidence: "Medium"

  - name: "System Configuration Access"
    description: "Detects unauthorized access to system configuration"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/config/system"
          - payload: "/config/database"
          - payload: "/config/security"
          - payload: "/config/network"
          - payload: "/config/backup"
        then:
          - if: "response.status == 200"
            issue: "System Configuration Access"
            detail: "Unauthorized access to system configuration"
            severity: "High"
            confidence: "Medium"

  - name: "Data Export Bypass"
    description: "Detects unauthorized access to data export functions"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/export/users"
          - payload: "/export/data"
          - payload: "/export/reports"
          - payload: "/export/logs"
          - payload: "/export/backup"
        then:
          - if: "response.status == 200"
            issue: "Data Export Bypass"
            detail: "Unauthorized access to data export functions"
            severity: "Medium"
            confidence: "Medium"

  - name: "API Management Bypass"
    description: "Detects unauthorized access to API management functions"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/api/keys"
          - payload: "/api/endpoints"
          - payload: "/api/limits"
          - payload: "/api/analytics"
          - payload: "/api/security"
        then:
          - if: "response.status == 200"
            issue: "API Management Bypass"
            detail: "Unauthorized access to API management functions"
            severity: "High"
            confidence: "Medium"

  - name: "Role Escalation"
    description: "Detects role escalation vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "X-Role: admin"
          - payload: "X-User-Role: admin"
          - payload: "X-Permission: admin"
          - payload: "X-Access-Level: admin"
        then:
          - if: "response.status == 200"
            issue: "Role Escalation"
            detail: "Role escalation vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Function Parameter Manipulation"
    description: "Detects function parameter manipulation vulnerabilities"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "action=delete"
          - payload: "action=create"
          - payload: "action=update"
          - payload: "action=admin"
          - payload: "action=system"
        then:
          - if: "response.status == 200"
            issue: "Function Parameter Manipulation"
            detail: "Function parameter manipulation vulnerability detected"
            severity: "Medium"
            confidence: "Medium"

  - name: "HTTP Method Bypass"
    description: "Detects HTTP method bypass vulnerabilities"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.method"
        inject:
          - payload: "DELETE"
          - payload: "PUT"
          - payload: "PATCH"
        then:
          - if: "response.status == 200"
            issue: "HTTP Method Bypass"
            detail: "HTTP method bypass vulnerability detected"
            severity: "Medium"
            confidence: "Medium"

  - name: "Privileged Endpoint Access"
    description: "Detects unauthorized access to privileged endpoints"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/internal/"
          - payload: "/private/"
          - payload: "/secure/"
          - payload: "/restricted/"
          - payload: "/confidential/"
        then:
          - if: "response.status == 200"
            issue: "Privileged Endpoint Access"
            detail: "Unauthorized access to privileged endpoints"
            severity: "High"
            confidence: "Medium"

filters:
  - name: "API Endpoints"
    when: "request"
    where: "request.url"
    include:
      - pattern: "/api/"
        flags: "i"
      - pattern: "/admin/"
        flags: "i"
      - pattern: "/management/"
        flags: "i"
      - pattern: "/system/"
        flags: "i"

settings:
  max_payloads_per_parameter: 12
  timeout: 10000
  follow_redirects: false
  respect_robots_txt: false
