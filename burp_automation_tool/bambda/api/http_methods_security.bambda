# HTTP Methods Security Bambda
# Detects HTTP method vulnerabilities and bypasses

metadata:
  name: "HTTP Methods Security Bambda"
  description: "Detects HTTP method vulnerabilities including method override, unauthorized methods, and method confusion attacks"
  author: "Burp Automation Tool"
  version: "1.0.0"
  tags: ["http-methods", "method-override", "method-confusion", "unauthorized-methods", "method-bypass"]

rules:
  - name: "HTTP Method Override"
    description: "Detects HTTP method override vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "X-HTTP-Method-Override: DELETE"
          - payload: "X-HTTP-Method-Override: PUT"
          - payload: "X-HTTP-Method-Override: PATCH"
          - payload: "X-HTTP-Method-Override: TRACE"
          - payload: "X-HTTP-Method-Override: OPTIONS"
        then:
          - if: "response.status == 200"
            issue: "HTTP Method Override"
            detail: "HTTP method override vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Method Override via Parameter"
    description: "Detects HTTP method override via request parameters"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "_method=DELETE"
          - payload: "_method=PUT"
          - payload: "_method=PATCH"
          - payload: "_method=TRACE"
          - payload: "_method=OPTIONS"
        then:
          - if: "response.status == 200"
            issue: "Method Override via Parameter"
            detail: "HTTP method override via parameter vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Method Override via Body"
    description: "Detects HTTP method override via request body"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"_method":"DELETE"}'
          - payload: '{"_method":"PUT"}'
          - payload: '{"_method":"PATCH"}'
          - payload: '{"_method":"TRACE"}'
          - payload: '{"_method":"OPTIONS"}'
        then:
          - if: "response.status == 200"
            issue: "Method Override via Body"
            detail: "HTTP method override via body vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Unauthorized HTTP Methods"
    description: "Detects unauthorized HTTP methods being accepted"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.method"
        inject:
          - payload: "DELETE"
          - payload: "PUT"
          - payload: "PATCH"
          - payload: "TRACE"
          - payload: "OPTIONS"
          - payload: "HEAD"
        then:
          - if: "response.status == 200"
            issue: "Unauthorized HTTP Methods"
            detail: "Unauthorized HTTP method accepted"
            severity: "Medium"
            confidence: "Medium"

  - name: "Method Confusion Attack"
    description: "Detects HTTP method confusion vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.method"
        inject:
          - payload: "GET"
          - payload: "POST"
          - payload: "PUT"
          - payload: "DELETE"
        then:
          - if: "response.status == 200"
            issue: "Method Confusion Attack"
            detail: "HTTP method confusion vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Dangerous HTTP Methods"
    description: "Detects dangerous HTTP methods being enabled"
    severity: "High"
    confidence: "High"
    
    active:
      - when: "request"
        where: "request.method"
        inject:
          - payload: "TRACE"
          - payload: "TRACK"
          - payload: "DEBUG"
          - payload: "CONNECT"
        then:
          - if: "response.status == 200"
            issue: "Dangerous HTTP Methods"
            detail: "Dangerous HTTP method enabled"
            severity: "High"
            confidence: "High"

  - name: "Method Override via Content-Type"
    description: "Detects HTTP method override via Content-Type header"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Content-Type: application/x-www-form-urlencoded; _method=DELETE"
          - payload: "Content-Type: application/x-www-form-urlencoded; _method=PUT"
          - payload: "Content-Type: application/x-www-form-urlencoded; _method=PATCH"
        then:
          - if: "response.status == 200"
            issue: "Method Override via Content-Type"
            detail: "HTTP method override via Content-Type vulnerability detected"
            severity: "Medium"
            confidence: "Medium"

  - name: "Method Override via URL"
    description: "Detects HTTP method override via URL parameters"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "?_method=DELETE"
          - payload: "?_method=PUT"
          - payload: "?_method=PATCH"
          - payload: "?_method=TRACE"
          - payload: "?_method=OPTIONS"
        then:
          - if: "response.status == 200"
            issue: "Method Override via URL"
            detail: "HTTP method override via URL vulnerability detected"
            severity: "Medium"
            confidence: "Medium"

  - name: "Method Override via Form Data"
    description: "Detects HTTP method override via form data"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: "_method=DELETE&data=test"
          - payload: "_method=PUT&data=test"
          - payload: "_method=PATCH&data=test"
          - payload: "_method=TRACE&data=test"
          - payload: "_method=OPTIONS&data=test"
        then:
          - if: "response.status == 200"
            issue: "Method Override via Form Data"
            detail: "HTTP method override via form data vulnerability detected"
            severity: "Medium"
            confidence: "Medium"

  - name: "Method Override via JSON"
    description: "Detects HTTP method override via JSON payload"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"_method":"DELETE","data":"test"}'
          - payload: '{"_method":"PUT","data":"test"}'
          - payload: '{"_method":"PATCH","data":"test"}'
          - payload: '{"_method":"TRACE","data":"test"}'
          - payload: '{"_method":"OPTIONS","data":"test"}'
        then:
          - if: "response.status == 200"
            issue: "Method Override via JSON"
            detail: "HTTP method override via JSON vulnerability detected"
            severity: "Medium"
            confidence: "Medium"

  - name: "Method Override via XML"
    description: "Detects HTTP method override via XML payload"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '<?xml version="1.0"?><root><_method>DELETE</_method><data>test</data></root>'
          - payload: '<?xml version="1.0"?><root><_method>PUT</_method><data>test</data></root>'
          - payload: '<?xml version="1.0"?><root><_method>PATCH</_method><data>test</data></root>'
          - payload: '<?xml version="1.0"?><root><_method>TRACE</_method><data>test</data></root>'
          - payload: '<?xml version="1.0"?><root><_method>OPTIONS</_method><data>test</data></root>'
        then:
          - if: "response.status == 200"
            issue: "Method Override via XML"
            detail: "HTTP method override via XML vulnerability detected"
            severity: "Medium"
            confidence: "Medium"

filters:
  - name: "API Endpoints"
    when: "request"
    where: "request.url"
    include:
      - pattern: "/api/"
        flags: "i"
      - pattern: "/rest/"
        flags: "i"
      - pattern: "/v[0-9]+/"
        flags: "i"
      - pattern: "/users/"
        flags: "i"
      - pattern: "/admin/"
        flags: "i"

settings:
  max_payloads_per_parameter: 12
  timeout: 10000
  follow_redirects: false
  respect_robots_txt: false
