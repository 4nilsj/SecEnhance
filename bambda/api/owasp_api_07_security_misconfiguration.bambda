# OWASP API Top 10 #7: Security Misconfiguration Bambda
# Detects security misconfiguration vulnerabilities in APIs

metadata:
  name: "OWASP API #7: Security Misconfiguration"
  description: "Detects security misconfiguration vulnerabilities including improper headers, CORS, and security settings"
  author: "Burp Automation Tool"
  version: "1.0.0"
  tags: ["owasp", "api", "security-misconfiguration", "headers", "cors", "security-settings"]

rules:
  - name: "CORS Misconfiguration"
    description: "Detects CORS misconfiguration vulnerabilities"
    severity: "Medium"
    confidence: "High"
    
    passive:
      - when: "response"
        where: "response.headers"
        matches:
          - pattern: "Access-Control-Allow-Origin: \\*"
            flags: "i"
          - pattern: "Access-Control-Allow-Credentials: true"
            flags: "i"
          - pattern: "Access-Control-Allow-Methods: \\*"
            flags: "i"
        then:
          - issue: "CORS Misconfiguration"
            detail: "CORS misconfiguration vulnerability detected"
            severity: "Medium"
            confidence: "High"

  - name: "Security Headers Missing"
    description: "Detects missing security headers"
    severity: "Medium"
    confidence: "High"
    
    passive:
      - when: "response"
        where: "response.headers"
        not_matches:
          - pattern: "X-Content-Type-Options"
            flags: "i"
          - pattern: "X-Frame-Options"
            flags: "i"
          - pattern: "X-XSS-Protection"
            flags: "i"
          - pattern: "Strict-Transport-Security"
            flags: "i"
        then:
          - issue: "Security Headers Missing"
            detail: "Security headers missing in response"
            severity: "Medium"
            confidence: "High"

  - name: "Information Disclosure Headers"
    description: "Detects information disclosure through headers"
    severity: "Low"
    confidence: "High"
    
    passive:
      - when: "response"
        where: "response.headers"
        matches:
          - pattern: "Server: .*"
            flags: "i"
          - pattern: "X-Powered-By: .*"
            flags: "i"
          - pattern: "X-AspNet-Version: .*"
            flags: "i"
          - pattern: "X-AspNetMvc-Version: .*"
            flags: "i"
        then:
          - issue: "Information Disclosure Headers"
            detail: "Information disclosure through headers"
            severity: "Low"
            confidence: "High"

  - name: "Debug Mode Enabled"
    description: "Detects debug mode enabled in production"
    severity: "High"
    confidence: "Medium"
    
    passive:
      - when: "response"
        where: "response.body"
        matches:
          - pattern: "debug.*mode.*enabled"
            flags: "i"
          - pattern: "development.*mode"
            flags: "i"
          - pattern: "stack.*trace"
            flags: "i"
          - pattern: "error.*details"
            flags: "i"
        then:
          - issue: "Debug Mode Enabled"
            detail: "Debug mode enabled in production"
            severity: "High"
            confidence: "Medium"

  - name: "Default Credentials"
    description: "Detects default credentials usage"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"username":"admin","password":"admin"}'
          - payload: '{"username":"root","password":"root"}'
          - payload: '{"username":"test","password":"test"}'
          - payload: '{"username":"guest","password":"guest"}'
          - payload: '{"username":"demo","password":"demo"}'
        then:
          - if: "response.status == 200"
            issue: "Default Credentials"
            detail: "Default credentials accepted"
            severity: "High"
            confidence: "Medium"

  - name: "Directory Listing Enabled"
    description: "Detects directory listing enabled"
    severity: "Medium"
    confidence: "High"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/"
          - payload: "/api/"
          - payload: "/admin/"
          - payload: "/config/"
          - payload: "/backup/"
        then:
          - if: "response.body contains 'Index of'"
            issue: "Directory Listing Enabled"
            detail: "Directory listing enabled"
            severity: "Medium"
            confidence: "High"

  - name: "Error Handling Misconfiguration"
    description: "Detects error handling misconfiguration"
    severity: "Medium"
    confidence: "Medium"
    
    passive:
      - when: "response"
        where: "response.body"
        matches:
          - pattern: "error.*in.*line"
            flags: "i"
          - pattern: "exception.*details"
            flags: "i"
          - pattern: "database.*error"
            flags: "i"
          - pattern: "sql.*syntax"
            flags: "i"
        then:
          - issue: "Error Handling Misconfiguration"
            detail: "Detailed error information exposed"
            severity: "Medium"
            confidence: "Medium"

  - name: "SSL/TLS Misconfiguration"
    description: "Detects SSL/TLS misconfiguration"
    severity: "High"
    confidence: "Medium"
    
    passive:
      - when: "response"
        where: "response.headers"
        matches:
          - pattern: "Strict-Transport-Security: max-age=0"
            flags: "i"
          - pattern: "Strict-Transport-Security: includeSubDomains=false"
            flags: "i"
        then:
          - issue: "SSL/TLS Misconfiguration"
            detail: "SSL/TLS security headers misconfigured"
            severity: "High"
            confidence: "Medium"

  - name: "API Version Exposure"
    description: "Detects API version information exposure"
    severity: "Low"
    confidence: "High"
    
    passive:
      - when: "response"
        where: "response.headers"
        matches:
          - pattern: "API-Version: .*"
            flags: "i"
          - pattern: "X-API-Version: .*"
            flags: "i"
          - pattern: "Version: .*"
            flags: "i"
        then:
          - issue: "API Version Exposure"
            detail: "API version information exposed"
            severity: "Low"
            confidence: "High"

  - name: "Cache Control Misconfiguration"
    description: "Detects cache control misconfiguration"
    severity: "Medium"
    confidence: "Medium"
    
    passive:
      - when: "response"
        where: "response.headers"
        matches:
          - pattern: "Cache-Control: public"
            flags: "i"
          - pattern: "Cache-Control: no-cache"
            flags: "i"
        then:
          - issue: "Cache Control Misconfiguration"
            detail: "Cache control misconfigured for sensitive data"
            severity: "Medium"
            confidence: "Medium"

filters:
  - name: "API Endpoints"
    when: "request"
    where: "request.url"
    include:
      - pattern: "/api/"
        flags: "i"
      - pattern: "/admin/"
        flags: "i"
      - pattern: "/config/"
        flags: "i"
      - pattern: "/auth/"
        flags: "i"

settings:
  max_payloads_per_parameter: 10
  timeout: 10000
  follow_redirects: true
  respect_robots_txt: false
