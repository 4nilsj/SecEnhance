# OWASP API Top 10 #10: Insufficient Logging & Monitoring Bambda
# Detects insufficient logging and monitoring vulnerabilities in APIs

metadata:
  name: "OWASP API #10: Insufficient Logging & Monitoring"
  description: "Detects insufficient logging and monitoring vulnerabilities that can lead to undetected attacks"
  author: "Burp Automation Tool"
  version: "1.0.0"
  tags: ["owasp", "api", "logging", "monitoring", "audit", "detection"]

rules:
  - name: "Failed Authentication Logging"
    description: "Detects insufficient logging of failed authentication attempts"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"username":"admin","password":"wrong_password"}'
          - payload: '{"username":"test","password":"wrong_password"}'
          - payload: '{"username":"user","password":"wrong_password"}'
        then:
          - if: "response.status == 401"
            issue: "Failed Authentication Logging"
            detail: "Failed authentication attempts may not be properly logged"
            severity: "Medium"
            confidence: "Medium"

  - name: "Rate Limiting Logging"
    description: "Detects insufficient logging of rate limiting events"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "X-Forwarded-For: 192.168.1.1"
          - payload: "X-Real-IP: 192.168.1.1"
          - payload: "X-Client-IP: 192.168.1.1"
        then:
          - if: "response.status == 429"
            issue: "Rate Limiting Logging"
            detail: "Rate limiting events may not be properly logged"
            severity: "Medium"
            confidence: "Medium"

  - name: "Error Logging"
    description: "Detects insufficient error logging"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "id=invalid_id"
          - payload: "user=invalid_user"
          - payload: "token=invalid_token"
        then:
          - if: "response.status == 500"
            issue: "Error Logging"
            detail: "Server errors may not be properly logged"
            severity: "Medium"
            confidence: "Medium"

  - name: "Access Logging"
    description: "Detects insufficient access logging"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/admin/"
          - payload: "/internal/"
          - payload: "/private/"
        then:
          - if: "response.status == 200"
            issue: "Access Logging"
            detail: "Access to sensitive endpoints may not be properly logged"
            severity: "Medium"
            confidence: "Medium"

  - name: "Data Access Logging"
    description: "Detects insufficient data access logging"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "user_id=1"
          - payload: "account_id=1"
          - payload: "order_id=1"
        then:
          - if: "response.status == 200"
            issue: "Data Access Logging"
            detail: "Data access may not be properly logged"
            severity: "Medium"
            confidence: "Medium"

  - name: "Configuration Change Logging"
    description: "Detects insufficient configuration change logging"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"setting":"debug_mode","value":true}'
          - payload: '{"setting":"log_level","value":"debug"}'
          - payload: '{"setting":"security_level","value":"low"}'
        then:
          - if: "response.status == 200"
            issue: "Configuration Change Logging"
            detail: "Configuration changes may not be properly logged"
            severity: "High"
            confidence: "Medium"

  - name: "User Action Logging"
    description: "Detects insufficient user action logging"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"action":"delete","target":"user"}'
          - payload: '{"action":"update","target":"permissions"}'
          - payload: '{"action":"create","target":"admin"}'
        then:
          - if: "response.status == 200"
            issue: "User Action Logging"
            detail: "User actions may not be properly logged"
            severity: "Medium"
            confidence: "Medium"

  - name: "API Key Usage Logging"
    description: "Detects insufficient API key usage logging"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "X-API-Key: test_key_1"
          - payload: "X-API-Key: test_key_2"
          - payload: "X-API-Key: test_key_3"
        then:
          - if: "response.status == 200"
            issue: "API Key Usage Logging"
            detail: "API key usage may not be properly logged"
            severity: "Medium"
            confidence: "Medium"

  - name: "Session Activity Logging"
    description: "Detects insufficient session activity logging"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "Cookie: session=test_session_1"
          - payload: "Cookie: session=test_session_2"
          - payload: "Cookie: session=test_session_3"
        then:
          - if: "response.status == 200"
            issue: "Session Activity Logging"
            detail: "Session activity may not be properly logged"
            severity: "Medium"
            confidence: "Medium"

  - name: "Audit Trail Logging"
    description: "Detects insufficient audit trail logging"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.body"
        inject:
          - payload: '{"operation":"delete","resource":"user","id":1}'
          - payload: '{"operation":"modify","resource":"permissions","id":1}'
          - payload: '{"operation":"create","resource":"admin","id":1}'
        then:
          - if: "response.status == 200"
            issue: "Audit Trail Logging"
            detail: "Audit trail may not be properly maintained"
            severity: "High"
            confidence: "Medium"

filters:
  - name: "API Endpoints"
    when: "request"
    where: "request.url"
    include:
      - pattern: "/api/"
        flags: "i"
      - pattern: "/admin/"
        flags: "i"
      - pattern: "/auth/"
        flags: "i"
      - pattern: "/users/"
        flags: "i"

settings:
  max_payloads_per_parameter: 10
  timeout: 10000
  follow_redirects: false
  respect_robots_txt: false
