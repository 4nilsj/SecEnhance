# OWASP API Top 10 #9: Improper Asset Management Bambda
# Detects improper asset management vulnerabilities in APIs

metadata:
  name: "OWASP API #9: Improper Asset Management"
  description: "Detects improper asset management vulnerabilities including deprecated APIs, version issues, and shadow APIs"
  author: "Burp Automation Tool"
  version: "1.0.0"
  tags: ["owasp", "api", "asset-management", "deprecated", "version", "shadow-api"]

rules:
  - name: "Deprecated API Endpoints"
    description: "Detects deprecated API endpoints"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/v1/"
          - payload: "/v0/"
          - payload: "/legacy/"
          - payload: "/old/"
          - payload: "/deprecated/"
        then:
          - if: "response.status == 200"
            issue: "Deprecated API Endpoints"
            detail: "Deprecated API endpoint accessible"
            severity: "Medium"
            confidence: "Medium"

  - name: "API Version Enumeration"
    description: "Detects API version enumeration vulnerabilities"
    severity: "Low"
    confidence: "High"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/v1/"
          - payload: "/v2/"
          - payload: "/v3/"
          - payload: "/v4/"
          - payload: "/v5/"
          - payload: "/v6/"
          - payload: "/v7/"
          - payload: "/v8/"
          - payload: "/v9/"
          - payload: "/v10/"
        then:
          - if: "response.status == 200"
            issue: "API Version Enumeration"
            detail: "API version enumeration vulnerability detected"
            severity: "Low"
            confidence: "High"

  - name: "Shadow API Detection"
    description: "Detects shadow API endpoints"
    severity: "Medium"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/internal/"
          - payload: "/private/"
          - payload: "/test/"
          - payload: "/dev/"
          - payload: "/staging/"
          - payload: "/beta/"
          - payload: "/alpha/"
        then:
          - if: "response.status == 200"
            issue: "Shadow API Detection"
            detail: "Shadow API endpoint detected"
            severity: "Medium"
            confidence: "Medium"

  - name: "API Documentation Exposure"
    description: "Detects API documentation exposure"
    severity: "Low"
    confidence: "High"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/swagger/"
          - payload: "/docs/"
          - payload: "/api-docs/"
          - payload: "/openapi/"
          - payload: "/redoc/"
          - payload: "/swagger-ui/"
          - payload: "/api-explorer/"
        then:
          - if: "response.status == 200"
            issue: "API Documentation Exposure"
            detail: "API documentation exposed"
            severity: "Low"
            confidence: "High"

  - name: "Backup File Exposure"
    description: "Detects backup file exposure"
    severity: "Medium"
    confidence: "High"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/backup/"
          - payload: "/backups/"
          - payload: "/.backup/"
          - payload: "/backup.zip"
          - payload: "/backup.tar.gz"
          - payload: "/backup.sql"
          - payload: "/backup.json"
        then:
          - if: "response.status == 200"
            issue: "Backup File Exposure"
            detail: "Backup files exposed"
            severity: "Medium"
            confidence: "High"

  - name: "Configuration File Exposure"
    description: "Detects configuration file exposure"
    severity: "High"
    confidence: "High"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/config/"
          - payload: "/.env"
          - payload: "/config.json"
          - payload: "/config.xml"
          - payload: "/settings.json"
          - payload: "/.config/"
          - payload: "/configuration/"
        then:
          - if: "response.status == 200"
            issue: "Configuration File Exposure"
            detail: "Configuration files exposed"
            severity: "High"
            confidence: "High"

  - name: "Log File Exposure"
    description: "Detects log file exposure"
    severity: "Medium"
    confidence: "High"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/logs/"
          - payload: "/log/"
          - payload: "/debug.log"
          - payload: "/error.log"
          - payload: "/access.log"
          - payload: "/application.log"
          - payload: "/system.log"
        then:
          - if: "response.status == 200"
            issue: "Log File Exposure"
            detail: "Log files exposed"
            severity: "Medium"
            confidence: "High"

  - name: "Source Code Exposure"
    description: "Detects source code exposure"
    severity: "High"
    confidence: "High"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/src/"
          - payload: "/source/"
          - payload: "/.git/"
          - payload: "/.svn/"
          - payload: "/.hg/"
          - payload: "/.bzr/"
          - payload: "/.cvs/"
        then:
          - if: "response.status == 200"
            issue: "Source Code Exposure"
            detail: "Source code exposed"
            severity: "High"
            confidence: "High"

  - name: "Database File Exposure"
    description: "Detects database file exposure"
    severity: "High"
    confidence: "High"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/db/"
          - payload: "/database/"
          - payload: "/data/"
          - payload: "/.db"
          - payload: "/.sqlite"
          - payload: "/.sqlite3"
          - payload: "/.db3"
        then:
          - if: "response.status == 200"
            issue: "Database File Exposure"
            detail: "Database files exposed"
            severity: "High"
            confidence: "High"

  - name: "Version Control Exposure"
    description: "Detects version control system exposure"
    severity: "High"
    confidence: "High"
    
    active:
      - when: "request"
        where: "request.url"
        inject:
          - payload: "/.git/config"
          - payload: "/.git/HEAD"
          - payload: "/.git/logs/HEAD"
          - payload: "/.svn/entries"
          - payload: "/.hg/hgrc"
          - payload: "/.bzr/branch-format"
        then:
          - if: "response.status == 200"
            issue: "Version Control Exposure"
            detail: "Version control system exposed"
            severity: "High"
            confidence: "High"

filters:
  - name: "API Endpoints"
    when: "request"
    where: "request.url"
    include:
      - pattern: "/api/"
        flags: "i"
      - pattern: "/v[0-9]+/"
        flags: "i"
      - pattern: "/docs/"
        flags: "i"
      - pattern: "/swagger/"
        flags: "i"

settings:
  max_payloads_per_parameter: 12
  timeout: 10000
  follow_redirects: true
  respect_robots_txt: false
