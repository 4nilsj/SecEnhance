# OWASP API Top 10 #1: Broken Object Level Authorization (BOLA) Bambda
# Detects Broken Object Level Authorization vulnerabilities in APIs

metadata:
  name: "OWASP API #1: Broken Object Level Authorization"
  description: "Detects Broken Object Level Authorization (BOLA) vulnerabilities where users can access objects they shouldn't have access to"
  author: "Burp Automation Tool"
  version: "1.0.0"
  tags: ["owasp", "api", "bola", "authorization", "object-level", "idor"]

rules:
  - name: "User ID Enumeration"
    description: "Detects user ID enumeration vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "user_id=1"
          - payload: "user_id=2"
          - payload: "user_id=999"
          - payload: "id=1"
          - payload: "id=2"
          - payload: "id=999"
        then:
          - if: "response.status == 200"
            issue: "User ID Enumeration"
            detail: "User ID enumeration vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Resource ID Manipulation"
    description: "Detects resource ID manipulation vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "resource_id=1"
          - payload: "resource_id=2"
          - payload: "resource_id=999"
          - payload: "file_id=1"
          - payload: "file_id=2"
          - payload: "file_id=999"
        then:
          - if: "response.status == 200"
            issue: "Resource ID Manipulation"
            detail: "Resource ID manipulation vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Order ID Manipulation"
    description: "Detects order ID manipulation vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "order_id=1"
          - payload: "order_id=2"
          - payload: "order_id=999"
          - payload: "transaction_id=1"
          - payload: "transaction_id=2"
          - payload: "transaction_id=999"
        then:
          - if: "response.status == 200"
            issue: "Order ID Manipulation"
            detail: "Order ID manipulation vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Document ID Manipulation"
    description: "Detects document ID manipulation vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "document_id=1"
          - payload: "document_id=2"
          - payload: "document_id=999"
          - payload: "file_id=1"
          - payload: "file_id=2"
          - payload: "file_id=999"
        then:
          - if: "response.status == 200"
            issue: "Document ID Manipulation"
            detail: "Document ID manipulation vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Account ID Manipulation"
    description: "Detects account ID manipulation vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "account_id=1"
          - payload: "account_id=2"
          - payload: "account_id=999"
          - payload: "customer_id=1"
          - payload: "customer_id=2"
          - payload: "customer_id=999"
        then:
          - if: "response.status == 200"
            issue: "Account ID Manipulation"
            detail: "Account ID manipulation vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "UUID Manipulation"
    description: "Detects UUID manipulation vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "uuid=00000000-0000-0000-0000-000000000000"
          - payload: "uuid=11111111-1111-1111-1111-111111111111"
          - payload: "uuid=ffffffff-ffff-ffff-ffff-ffffffffffff"
        then:
          - if: "response.status == 200"
            issue: "UUID Manipulation"
            detail: "UUID manipulation vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Object Access Bypass"
    description: "Detects object access bypass vulnerabilities"
    severity: "High"
    confidence: "Medium"
    
    active:
      - when: "request"
        where: "request.headers"
        inject:
          - payload: "X-User-ID: 1"
          - payload: "X-User-ID: 2"
          - payload: "X-User-ID: 999"
          - payload: "X-Account-ID: 1"
          - payload: "X-Account-ID: 2"
          - payload: "X-Account-ID: 999"
        then:
          - if: "response.status == 200"
            issue: "Object Access Bypass"
            detail: "Object access bypass vulnerability detected"
            severity: "High"
            confidence: "Medium"

  - name: "Sequential ID Enumeration"
    description: "Detects sequential ID enumeration vulnerabilities"
    severity: "Medium"
    confidence: "High"
    
    active:
      - when: "request"
        where: "request.parameters"
        inject:
          - payload: "id=1000"
          - payload: "id=1001"
          - payload: "id=1002"
          - payload: "id=1003"
          - payload: "id=1004"
        then:
          - if: "response.status == 200"
            issue: "Sequential ID Enumeration"
            detail: "Sequential ID enumeration vulnerability detected"
            severity: "Medium"
            confidence: "High"

filters:
  - name: "API Endpoints"
    when: "request"
    where: "request.url"
    include:
      - pattern: "/api/"
        flags: "i"
      - pattern: "/users/"
        flags: "i"
      - pattern: "/orders/"
        flags: "i"
      - pattern: "/accounts/"
        flags: "i"
      - pattern: "/documents/"
        flags: "i"

settings:
  max_payloads_per_parameter: 15
  timeout: 10000
  follow_redirects: false
  respect_robots_txt: false
